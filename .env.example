# Copy to .env and fill in. Never commit .env.

# Anthropic API key (or use `ant auth login`). Use an organization with zero-data-retention or
# no-training terms appropriate for confidential client information.
ANTHROPIC_API_KEY=

# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LEGALBOT_SECRET_KEY=

# 1 = allow session cookies over plain HTTP (local development only).
LEGALBOT_DEV=0

# Store question text in the audit log (1) or only metadata (0). Questions can contain client confidences.
LEGALBOT_AUDIT_QUESTIONS=1

# Retrieval components (1 = on). The re-ranker is off by default: on the eval set it did not help.
LEGALBOT_USE_VECTORS=1
LEGALBOT_USE_RERANKER=0

# Optional: CourtListener token for importing recent opinions.
COURTLISTENER_API_TOKEN=
